# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Site login (the one shared account everyone uses to sign in) ---
SITE_USERNAME=teamaccount
# Generate with: npm run hash-password -- 'your-real-password'
SITE_PASSWORD_HASH=$2a$10$replace_with_generated_hash

# Long random string used to sign session cookies. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_long_random_string

# --- Shared piKVM credentials ---
# This should be a real account that exists on every piKVM listed in
# pikvms.json (create one with `kvmd-htpasswd` on each piKVM, or reuse an
# existing admin/viewer account). The dashboard backend logs in with these
# credentials on users' behalf so no one ever sees piKVM's own login page.
PIKVM_USER=admin
PIKVM_PASS=replace_with_pikvm_password

# --- App server ---
PORT=3000
STATUS_POLL_INTERVAL_MS=10000
NODE_ENV=production
